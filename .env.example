# Parcolia — environment variables.
# Copy to .env.local for local development. NEVER commit real secrets.

# --- Supabase -------------------------------------------------------------
# Project URL (local: printed by `npx supabase start`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Public anon key (safe in the browser; RLS protects the data)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — SERVER ONLY (bypasses RLS). Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- App --------------------------------------------------------------------
# Public URL of the app, used in email links (no trailing slash).
# Production: https://app.parcolia.ma (two domains) or https://parcolia.ma (one domain).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: the public marketing site when it has its own domain (e.g. https://parcolia.ma).
# Leave empty to serve everything from NEXT_PUBLIC_SITE_URL. See docs/DEPLOY.md.
NEXT_PUBLIC_MARKETING_URL=
# Support WhatsApp number shown on the public site, e.g. +212600000000 (empty = hidden).
NEXT_PUBLIC_SUPPORT_WHATSAPP=

# --- Email (SMTP) -----------------------------------------------------------
# Local: the Supabase test mailbox (Mailpit) — see http://127.0.0.1:54324
# Production: Resend SMTP (host smtp.resend.com, port 465, user "resend", password = API key)
SMTP_HOST=127.0.0.1
SMTP_PORT=54325
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="Parcolia <no-reply@parcolia.ma>"

# --- Scheduled jobs ---------------------------------------------------------
# Secret the scheduler sends as "Authorization: Bearer …" to /api/cron/* (Vercel Cron does it automatically)
CRON_SECRET=

# --- Assistant IA ---------------------------------------------------------------
# Groq (free models): if GROQ_API_KEY is set, the assistant uses Groq with 3 models
# in a row: if one is down or rate-limited, the next one answers. Server only.
# Free tier = about 8 000 tokens per minute per model (a few questions per minute):
# fine for tests; for many agencies take Groq's "Dev tier" (pay as you go).
GROQ_API_KEY=
# Optional: models in order of preference (comma-separated). Default:
# openai/gpt-oss-120b,qwen/qwen3.8-27b,openai/gpt-oss-20b
GROQ_MODELS=
# Optional: image model for the inspection « Comparaison IA » (default qwen/qwen3.8-27b, free on Groq).
VISION_MODEL=
# Claude (used when GROQ_API_KEY is empty, or with AI_PROVIDER=anthropic):
# Claude API key (console.anthropic.com). Server only: never NEXT_PUBLIC_.
# Without it the assistant page says it is not connected yet.
ANTHROPIC_API_KEY=
# Optional: model id (default claude-opus-5-5).
ANTHROPIC_MODEL=
# AI_PROVIDER=groq|anthropic picks one when both keys are set.
# Tests / local dev without a key: AI_PROVIDER=mock (ignored on Vercel production).
AI_PROVIDER=

# --- Abonnement (manual payment instructions shown to admins, invoice header) ---
PARCOLIA_LEGAL_NAME=Parcolia
PARCOLIA_LEGAL_ADDRESS=
PARCOLIA_ICE=
PARCOLIA_RC=
PARCOLIA_BANK_NAME=
PARCOLIA_BANK_RIB=
PARCOLIA_BILLING_PHONE=
PARCOLIA_BILLING_EMAIL=

# --- Vie privée (page /privacy) -------------------------------------------------
# Where the Supabase project is hosted, e.g. "Union européenne (Francfort)".
PARCOLIA_DATA_REGION=
# Contact for privacy requests (defaults to PARCOLIA_BILLING_EMAIL).
PARCOLIA_PRIVACY_EMAIL=
# CNDP declaration number, shown once you have it.
NEXT_PUBLIC_CNDP_NUMBER=

# --- Error monitoring (optional) -----------------------------------------------
# Sentry project DSN (sentry.io). Leave empty to turn monitoring off.
NEXT_PUBLIC_SENTRY_DSN=
# Build only (Vercel production): releases + readable stack traces. All three or none.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# --- Supabase plan limits (usage email to platform admins at 80 % / 95 %) ---------
# Defaults = Supabase Free plan. Pro plan: 8192 / 100 / 100000.
SUPABASE_LIMIT_DB_MB=
SUPABASE_LIMIT_STORAGE_GB=
SUPABASE_LIMIT_MAU=

# --- Tests only (never on Vercel) ------------------------------------------------
# PARCOLIA_DEV_UI=1, AI_PROVIDER=mock and RATE_LIMIT_EXEMPT_IPS are set by playwright.config.ts.

# --- Demo agency script (scripts/demo/create-demo-agency.mjs) ----------------------
# Put these in .env.production.local (ignored by git) together with the PRODUCTION
# NEXT_PUBLIC_SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY, then run `npm run demo:create`.
# DEMO_PASSWORD=
# DEMO_ADMIN_EMAIL=demo@parcolia.ma
# DEMO_STAFF_EMAIL=demo-staff@parcolia.ma
